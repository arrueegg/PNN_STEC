# This worktree shares the repository but not the ~640 GB of untracked data and results,
# which live in the primary checkout. Source this before running stages here:
#     source .env.worktree
# The same variables let a reader of the published code point the pipeline at their own
# copy without editing source.
export STEC_LEGACY_ROOT=/scratch2/arrueegg/WP4/PNN_STEC
export STEC_REPO_DATA=/scratch2/arrueegg/WP4/PNN_STEC/data
